+def raise_open_file_limit():
+    """Raise the soft limit on open files to the hard limit.
+
+    With PyTorch's default "file_descriptor" sharing strategy, every tensor
+    that the DataLoader worker sends keeps a file descriptor open in this
+    process while the tensor is alive. Each camera has several tensors, so a
+    large --bsz can exceed the common soft limit of 1024. The pin memory
+    thread then fails with "received 0 items of ancdata"
+    (https://github.com/nyu-systems/CLM-GS/issues/1).
+    """
+    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
+    if soft < hard:
+        resource.setrlimit(resource.RLIMIT_NOFILE, (hard, hard))
+    print(f"Open file limit: {soft} -> {hard}")
+
